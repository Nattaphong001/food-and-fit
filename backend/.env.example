DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=

PORT=
JWT_SECRET=

# debug = โชว์ log เต็ม (ใช้ตอน dev บนเครื่องเท่านั้น), release = ปิด log ละเอียด (ต้องตั้งตอน deploy จริงเสมอ)
GIN_MODE=

# รายชื่อ origin ที่อนุญาตให้เรียก API ข้าม browser (คั่นด้วย comma) — เว้นว่างได้ถ้าไม่มีหน้าเว็บเรียก
ALLOWED_ORIGINS=

# ถ้ามีใบรับรอง TLS ให้ใส่ path ทั้งสองค่านี้เพื่อรันเป็น HTTPS โดยตรง (ปกติ production ควรใช้ reverse proxy ทำ TLS แทน)
TLS_CERT_FILE=
TLS_KEY_FILE=

SMTP_EMAIL=
SMTP_PASSWORD=
